{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=llm_tutor_teaching;Username=postgres;Password=postgres;"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "LLMTutorRoom",
      "Audience": "LLMTutorRoom.Client",
      "SigningKey": "development-only-llmtutorroom-signing-key-change-me",
      "TokenLifetimeMinutes": 480
    }
  },
  "IntegrationEvents": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "llm",
    "Password": "llm-dev",
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 20,
    "RetryBaseDelaySeconds": 5,
    "RetryMaxDelaySeconds": 300,
    "PublishedMessageRetentionDays": 30,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 500
  },
  "AllowedHosts": "*"
}
