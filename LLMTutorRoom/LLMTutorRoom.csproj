<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ClientAppDirectory>ClientApp</ClientAppDirectory>
        <ClientBuildStamp>$(BaseIntermediateOutputPath)client-build.stamp</ClientBuildStamp>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.17" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared.Auth\Shared.Auth.csproj" />
        <ProjectReference Include="..\AttemptService.Contracts\AttemptService.Contracts.csproj" />
        <ProjectReference Include="..\ReviewService.Contracts\ReviewService.Contracts.csproj" />
        <ProjectReference Include="..\TeachingService.Contracts\TeachingService.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ClientBuildInput Include="$(ClientAppDirectory)/index.html" />
        <ClientBuildInput Include="$(ClientAppDirectory)/package.json" />
        <ClientBuildInput Include="$(ClientAppDirectory)/package-lock.json" />
        <ClientBuildInput Include="$(ClientAppDirectory)/.nvmrc" />
        <ClientBuildInput Include="$(ClientAppDirectory)/eslint.config.js" />
        <ClientBuildInput Include="$(ClientAppDirectory)/vite.config.js" />
        <ClientBuildInput Include="$(ClientAppDirectory)/src/**/*" />
    </ItemGroup>

    <Target Name="InstallClientDependencies" BeforeTargets="Build"
            Condition="'$(SkipClientBuild)' != 'true'"
            Inputs="$(ClientAppDirectory)/package.json;$(ClientAppDirectory)/package-lock.json"
            Outputs="$(ClientAppDirectory)/node_modules/.package-lock.json">
        <Exec WorkingDirectory="$(ClientAppDirectory)" Command="npm ci" />
    </Target>

    <Target Name="BuildClientApp" BeforeTargets="Build" DependsOnTargets="InstallClientDependencies" Condition="'$(SkipClientBuild)' != 'true'" Inputs="@(ClientBuildInput)" Outputs="$(ClientBuildStamp);wwwroot/index.html">
        <Exec WorkingDirectory="$(ClientAppDirectory)" Command="npm run build" />
        <Touch Files="$(ClientBuildStamp)" AlwaysCreate="true" />
    </Target>

</Project>
