{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=llm_tutor_room;Username=postgres;Password=postgres;"
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "llm",
    "Password": "llm-dev"
  },
  "AttemptSubmissionOutbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "RetryDelaySeconds": 15,
    "BatchSize": 25,
    "PublishedMessageRetentionDays": 30,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 500
  },
  "TeachingService": {
    "BaseUrl": "http://localhost:5212",
    "RequestTimeoutSeconds": 15
  },
  "ReviewService": {
    "BaseUrl": "http://127.0.0.1:5214",
    "RequestTimeoutSeconds": 15
  },
  "Auth": {
    "Jwt": {
      "Issuer": "LLMTutorRoom",
      "Audience": "LLMTutorRoom.Client",
      "SigningKey": "development-only-llmtutorroom-signing-key-change-me",
      "TokenLifetimeMinutes": 480
    }
  },
  "AllowedHosts": "*"
}
