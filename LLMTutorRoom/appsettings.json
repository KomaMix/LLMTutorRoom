{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=llm_tutor_room;Username=postgres;Password=postgres;"
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "llm",
    "Password": "llm-dev",
    "ExchangeName": "llmtutorroom.review",
    "QueueName": "llmtutorroom.review.check",
    "RoutingKey": "review.check",
    "RetryExchangeName": "llmtutorroom.review.retry",
    "RetryQueueNamePrefix": "llmtutorroom.review.retry",
    "RetryRoutingKeyPrefix": "review.check.retry",
    "DeadLetterExchangeName": "llmtutorroom.review.dead",
    "DeadLetterQueueName": "llmtutorroom.review.dlq",
    "DeadLetterRoutingKey": "review.check.dead",
    "PrefetchCount": 1,
    "ConnectionRetryDelaySeconds": 5,
    "RetryDelaysSeconds": [ 30, 120, 600, 1800 ]
  },
  "ReviewProcessing": {
    "WorkerEnabled": true,
    "LlmGatewayEnabled": false,
    "LlmGatewayBaseUrl": "http://localhost:5200",
    "LlmModelKey": "gemma3:12b",
    "LlmRequestTimeoutSeconds": 90,
    "ProcessingLeaseSeconds": 300,
    "QueueMaintenanceIntervalSeconds": 30,
    "EnqueueThrottleSeconds": 120,
    "TestLlmFailurePauseSeconds": 1800
  },
  "TeachingService": {
    "BaseUrl": "http://localhost:5212",
    "RequestTimeoutSeconds": 15
  },
  "Auth": {
    "Jwt": {
      "Issuer": "LLMTutorRoom",
      "Audience": "LLMTutorRoom.Client",
      "SigningKey": "development-only-llmtutorroom-signing-key-change-me",
      "TokenLifetimeMinutes": 480
    }
  },
  "AllowedHosts": "*"
}
