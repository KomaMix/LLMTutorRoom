{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=llm_tutor_reviews;Username=postgres;Password=postgres;"
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "llm",
    "Password": "llm-dev",
    "IntegrationQueueName": "review-service.integration",
    "IntegrationRetryExchangeName": "review.integration.retry",
    "IntegrationRetryQueueName": "review-service.integration.retry",
    "IntegrationRetryDelaySeconds": 15,
    "IntegrationMaxRetryAttempts": 5,
    "IntegrationDeadLetterExchangeName": "review.integration.dead",
    "IntegrationDeadLetterQueueName": "review-service.integration.dlq",
    "IntegrationDeadLetterRoutingKey": "review.integration.dead",
    "WorkExchangeName": "review.processing",
    "WorkQueueName": "review.processing.check",
    "WorkRoutingKey": "review.check",
    "RetryExchangeName": "review.processing.retry",
    "RetryQueueNamePrefix": "review.processing.retry",
    "RetryRoutingKeyPrefix": "review.check.retry",
    "DeadLetterExchangeName": "review.processing.dead",
    "DeadLetterQueueName": "review.processing.dlq",
    "DeadLetterRoutingKey": "review.check.dead",
    "PrefetchCount": 1,
    "ConnectionRetryDelaySeconds": 5,
    "RetryDelaysSeconds": [ 30, 120, 600, 1800 ]
  },
  "ReviewProcessing": {
    "WorkerEnabled": true,
    "LlmGatewayEnabled": true,
    "LlmGatewayBaseUrl": "http://localhost:5200",
    "LlmRequestTimeoutSeconds": 90,
    "ProcessingLeaseSeconds": 300,
    "QueueMaintenanceIntervalSeconds": 30,
    "EnqueueThrottleSeconds": 120
  },
  "ReviewStorage": {
    "InboxRetentionDays": 90,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 1000,
    "PendingSubmissionWarningHours": 24
  },
  "Auth": {
    "Jwt": {
      "Issuer": "LLMTutorRoom",
      "Audience": "LLMTutorRoom.Client",
      "SigningKey": "development-only-llmtutorroom-signing-key-change-me",
      "TokenLifetimeMinutes": 480
    }
  },
  "AllowedHosts": "*"
}
